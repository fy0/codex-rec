[Unit]
Description=tsroll - keep a fresh x-codex-turn-state injected into codex-rec
Documentation=file:///root/tsgrab/tsroll.py
# Needs the proxy to be up, but must not be stopped by it: if codex-rec restarts, tsroll's
# rotation is still valid (the token file is re-read per request), so this is Wants, not Requires.
After=network-online.target codex-rec.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/tsgrab/tsroll.py --refresh-after 35 --retry 30 --retry-jitter 5 --budget 40 --idle 1800
Restart=always
RestartSec=15
# The loop is plain Python that reads a file and occasionally runs one tsgrab; nothing
# privileged is needed.
StandardOutput=append:/root/tsgrab/state/service.log
StandardError=append:/root/tsgrab/state/service.log

[Install]
WantedBy=multi-user.target
